# Copy to .env locally. Never commit real values.
GEMINI_API_KEY=
G2B_SERVICE_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Supabase: use the session pooler URL with sslmode=require.
# Empty means local SQLite, NOT a shared production database.
DATABASE_URL=
# Manual web collection disabled unless an operator password is configured.
ADMIN_PASSWORD=
ENABLED_COLLECTORS=NIA,조달청
COLLECTION_LIMIT=10
MAX_ANALYSES_PER_RUN=5
MAX_ANALYSES_PER_DAY=50
